# Base URL Playwright uses when the dev server binds elsewhere (optional)
# ORIGIN=http://127.0.0.1:4173

# Warn when PDF page count exceeds this limit (default: 2)
# CV_PAGE_WARNING_LIMIT=2

# Maximum import payload size in bytes (default: 262144)
# MAX_IMPORT_BYTES=262144

# Bun adapter listen port (default: 3000)
# PORT=3000
